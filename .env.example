# Copy to .env and fill in. Real .env is gitignored.

# LLM providers
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Default LLM provider: "claude" or "gemini"
PIA_LLM_PROVIDER=claude
# Haiku is the default — ~20x cheaper than Opus, plenty for text-to-SQL.
# Switch to claude-opus-4-7 for harder reasoning tasks.
PIA_LLM_MODEL_CLAUDE=claude-haiku-4-5
PIA_LLM_MODEL_GEMINI=gemini-2.0-flash

# Storage backend: "duckdb" or "bigquery"
PIA_STORAGE_BACKEND=duckdb
PIA_DUCKDB_PATH=data/warehouse/pia.duckdb

# BigQuery (only used when PIA_STORAGE_BACKEND=bigquery)
GOOGLE_CLOUD_PROJECT=your-project-id
PIA_BQ_DATASET=pia

# Governance
PIA_K_ANON_THRESHOLD=5
PIA_TOKEN_BUDGET_PER_QUERY=50000
PIA_MAX_TOOL_CALLS=8
PIA_BQ_BYTES_SCANNED_LIMIT=1073741824

# Requester role for the current session (HRBP | RECRUITER | LEADER | ANALYST)
PIA_REQUESTER_ROLE=ANALYST

# Observability
PIA_PUSHGATEWAY_URL=http://localhost:9091
